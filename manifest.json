{
  "manifest_version": 3,
  "name": "Redraft",
  "version": "0.2.0",
  "description": "Improves your writing in the box where you're already writing it.",
  "permissions": ["storage"],
  "host_permissions": ["https://api.anthropic.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["lib/match.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "trigger-redraft": {
      "suggested_key": {
        "default": "Ctrl+Shift+K"
      },
      "description": "Redraft the currently focused text field"
    }
  }
}
