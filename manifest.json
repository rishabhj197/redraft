{
  "manifest_version": 3,
  "name": "Redraft",
  "version": "0.3.0",
  "description": "Improves your writing in the box where you're already writing it.",
  "permissions": ["storage", "scripting"],
  "host_permissions": ["<all_urls>", "https://api.anthropic.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["lib/match.js", "lib/trigger.js", "content.js"],
      "all_frames": true,
      "match_about_blank": true,
      "run_at": "document_idle"
    }
  ],
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "commands": {
    "trigger-redraft": {
      "suggested_key": {
        "default": "Ctrl+Shift+K"
      },
      "description": "Ask Redraft for hints on the focused field"
    },
    "apply-hint": {
      "suggested_key": {
        "default": "Ctrl+Shift+L"
      },
      "description": "Apply the first Redraft hint"
    }
  }
}
